generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String               @id @default(cuid())
  upstoxUserId String               @unique
  name         String?
  email        String?
  token        Token?
  watchlist    WatchlistItem[]
  aiSignals    AiSignal[]
  paperAccount PaperTradingAccount?
  paperOrders  PaperOrder[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

model PaperTradingAccount {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled           Boolean  @default(true)
  autoDemoTrading   Boolean  @default(true)
  startingBalance   Float    @default(10000)
  minimumConfidence Float    @default(90)
  maxOpenTrades     Int      @default(5)
  riskPerTrade      Float    @default(2)
  capitalPerTrade   Float    @default(10000)
  minimumRiskReward Float    @default(3)
  allowAiWait       Boolean  @default(true)
  allowReentry      Boolean  @default(true)
  voiceAlerts       Boolean  @default(true)
  voiceVolume       Int      @default(100)
  voiceSpeed        Float    @default(1)
  voicePitch        Float    @default(1)
  voiceLanguage     String   @default("en-IN")
  entryMode         String   @default("TARGET1_CONFIRMATION")
  exitMode          String   @default("EXIT_AT_TARGET3")
  maximumHoldingMinutes Int  @default(180)
  minimumDailyTrades Int     @default(2)
  preferredDailyTrades Int   @default(5)
  maximumDailyTrades Int     @default(10)
  maximumDailyLoss Float     @default(1000)
  maximumDailyProfit Float   @default(2000)
  squareOffTime     String   @default("14:45")
  realizedPnl       Float    @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model PaperOrder {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  signalId        String?   @unique
  instrumentKey   String
  symbol          String
  side            String
  product         String    @default("I")
  productType     String    @default("INTRADAY")
  confidence      Float
  status          String    @default("WAITING")
  quantity        Float
  remainingQuantity Float?
  budget          Float
  plannedEntry    Float
  entryPrice      Float?
  currentPrice    Float
  marketValue     Float     @default(0)
  investment      Float
  notionalValue   Float     @default(0)
  requiredIntradayMargin Float @default(0)
  availableCapitalAtEntry Float @default(0)
  marginPerShare  Float     @default(0)
  maximumMarginQuantity Int @default(0)
  riskAmount      Float     @default(0)
  riskPerShare    Float     @default(0)
  riskBasedQuantity Int     @default(0)
  estimatedCharges Float    @default(0)
  expectedGrossProfit Float @default(0)
  expectedNetProfit Float   @default(0)
  grossPnl        Float     @default(0)
  netPnl          Float     @default(0)
  unrealizedPnl   Float     @default(0)
  unrealizedPnlPercent Float @default(0)
  target          Float
  target1         Float?
  target2         Float?
  stopLoss        Float
  tradeStage      String    @default("RUNNING")
  strategy        String    @default("Target 1 Confirmation")
  entryType       String    @default("Confirmed Breakout")
  target1Time     DateTime?
  target2HitAt    DateTime?
  target3HitAt    DateTime?
  initialStopLoss Float?
  trailingStop    Float?
  rankScore       Float     @default(0)
  entryQuality    String    @default("Good")
  partialExitQuantity Float @default(0)
  partialExitPrice Float?
  partialExitAt   DateTime?
  partialRealizedPnl Float  @default(0)
  entryTime       DateTime?
  exitTime        DateTime?
  completedAt     DateTime?
  exitPrice       Float?
  pnl             Float     @default(0)
  pnlPercent      Float     @default(0)
  exitReason      String?
  durationMinutes Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId, status])
  @@index([userId, instrumentKey, createdAt])
}

model DemoStrategyOptimizer {
  id                  String   @id @default(cuid())
  userId              String
  tradingDate         String
  bestStrategy        String?
  bestSector          String?
  bestTime            String?
  bestConfidence      Float?
  bestAiScore         Float?
  bestRiskReward      Float?
  worstStrategy       String?
  worstSector         String?
  worstTime           String?
  worstConfidence     Float?
  sampleSize          Int      @default(0)
  summary             String   @default("{}")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([userId, tradingDate])
  @@index([userId, tradingDate])
}

model DemoExecutionDecision {
  id             String   @id @default(cuid())
  userId         String
  signalId       String
  instrumentKey  String
  symbol         String
  side           String
  signalStatus   String
  decision       String
  reason         String
  currentPrice   Float
  target1Time    DateTime?
  confidence     Float
  riskReward     Float
  availableCapital Float
  capitalPerTrade Float
  createdAt      DateTime @default(now())

  @@unique([signalId, decision, reason])
  @@index([userId, createdAt])
  @@index([userId, decision, createdAt])
}

model PaperVoiceAlert {
  id         String   @id @default(cuid())
  userId     String
  tradeId    String
  eventName  String
  symbol     String
  title      String
  message    String
  payload    String   @default("{}")
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  spokenAt   DateTime?

  @@unique([userId, tradeId, eventName])
  @@index([userId, status, createdAt])
}

model DemoTradeQueue {
  id            String   @id @default(cuid())
  userId        String
  signalId      String   @unique
  instrumentKey String
  symbol        String
  side          String
  entryPrice    Float
  confidence    Float
  aiScore       Float
  riskReward    Float
  signalTime    DateTime
  status        String   @default("WAITING_FOR_CAPITAL")
  queuedAt      DateTime @default(now())
  executedAt    DateTime?
  rejectedAt    DateTime?
  rejectReason  String?
  updatedAt     DateTime @updatedAt

  @@index([userId, status, confidence, aiScore])
}

model RealTradingAccount {
  id                 String   @id @default(cuid())
  userId             String   @unique
  tradingCapital     Float    @default(10000)
  maxOpenTrades      Int      @default(5)
  riskPerTrade       Float    @default(1)
  minimumConfidence  Float    @default(75)
  maxDailyLoss       Float    @default(1000)
  maxDailyProfit     Float    @default(2000)
  autoTrading        Boolean  @default(false)
  buySignals         Boolean  @default(true)
  sellSignals        Boolean  @default(true)
  squareOffTime      String   @default("15:15")
  entryMode          String   @default("IMMEDIATE_ENTRY")
  aggressiveMode     Boolean  @default(false)
  connectionTime     DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model RealTradeOrder {
  id              String    @id @default(cuid())
  userId          String
  signalId        String    @unique
  brokerOrderId   String?   @unique
  instrumentKey   String
  symbol          String
  side            String
  aiConfidence    Float
  aiAnalysis      String
  tradeQualityScore Float   @default(0)
  qualityRating   String    @default("Skip")
  momentumScore  Float     @default(0)
  trendStrength  Float     @default(0)
  volumeScore    Float     @default(0)
  riskScore      Float     @default(0)
  targetProbability Float  @default(0)
  expectedProfit Float     @default(0)
  expectedHoldingMinutes Int @default(0)
  entryDelayMs   Int       @default(0)
  executionQuality String  @default("Unrated")
  marketCondition String   @default("Unknown")
  sectorStrength Float     @default(0)
  niftyTrend     String    @default("Unknown")
  bankNiftyTrend String    @default("Unknown")
  brokerage      Float?
  taxes          Float?
  slippage       Float?
  netProfit      Float?
  status          String
  entryPrice      Float
  currentPrice    Float
  highestPrice    Float?
  lowestPrice     Float?
  maxDrawdown     Float     @default(0)
  quantity        Int
  remainingQuantity Int
  allocatedCapital Float
  investment      Float
  target1         Float
  target2         Float
  target3         Float
  stopLoss        Float
  currentStop     Float
  targetProgress  String    @default("ENTRY")
  target1ExitTime DateTime?
  target1ExitPrice Float?
  target2ExitTime DateTime?
  target2ExitPrice Float?
  realizedPnl     Float     @default(0)
  pnl             Float     @default(0)
  pnlPercent      Float     @default(0)
  executionTime   DateTime?
  exitPrice       Float?
  exitReason      String?
  exitTime        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId, status])
}

model RealTradeQueue {
  id            String   @id @default(cuid())
  userId        String
  signalId      String   @unique
  instrumentKey String
  symbol        String
  side          String
  entryPrice    Float
  confidence    Float
  aiScore       Float
  riskReward    Float
  rankScore     Float    @default(0)
  volumeRatio   Float    @default(0)
  trendStrength Float    @default(0)
  vwapAligned   Boolean  @default(false)
  emaAligned    Boolean  @default(false)
  momentum      Float    @default(0)
  atrQuality    Float    @default(0)
  entryMode     String   @default("TARGET1_CONFIRMATION")
  runningTime   DateTime?
  target1Reached Boolean  @default(false)
  target1Time   DateTime?
  target1Price  Float?
  target1Momentum Float?
  target1Volume Float?
  target1VolumeIncreasing Boolean?
  target1Vwap   Float?
  target1Ema20  Float?
  target1Ema50  Float?
  target1Rsi    Float?
  target1Macd   Float?
  target1Atr    Float?
  decisionResult String  @default("PENDING")
  blockingCondition String?
  signalTime    DateTime
  status        String   @default("WAITING_FOR_SLOT")
  displayStatus String   @default("Waiting")
  validationLog String   @default("[]")
  brokerResponse String?
  queuedAt      DateTime @default(now())
  resolvedAt    DateTime?
  reason        String?
  updatedAt     DateTime @updatedAt

  @@index([userId, status, confidence, aiScore])
}

model EodRiskRun {
  id             String    @id @default(cuid())
  tradingDate    String
  userId         String
  scope          String
  status         String
  brokerOrderIds String?
  alert          String?
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  updatedAt      DateTime  @updatedAt

  @@unique([tradingDate, userId, scope])
  @@index([tradingDate, status])
}

model AiSignal {
  id                   String            @id @default(cuid())
  signalKey            String            @unique
  userId               String
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  events               AiTradeEvent[]
  stopLossDecision     StopLossDecision?
  managementDecision   TradeManagementDecision?
  postTradeAnalysis    PostTradeAnalysis?
  instrumentKey        String
  stockName            String
  symbol               String
  sector               String            @default("NSE Equity")
  strategy             String
  timeframe            String
  side                 String
  signalTime           DateTime          @default(now())
  signalGeneratedAt    DateTime          @default(now())
  currentPrice         Float
  entryPrice           Float
  stopLoss             Float
  target1              Float
  target2              Float
  target3              Float
  confidence           Int
  aiScore              Int
  riskReward           Float
  volume               Float             @default(0)
  universeRank         Int               @default(0)
  selectionScore       Float             @default(0)
  volumeRatio          Float             @default(0)
  trendStrengthScore   Float             @default(0)
  vwapAligned          Boolean           @default(false)
  emaAligned           Boolean           @default(false)
  momentumScore        Float             @default(0)
  atrQuality           Float             @default(0)
  finalTradingScore    Float             @default(0)
  tradeQualityScore    Float             @default(0)
  tradeQualityRating   String            @default("Skip")
  qualityComponents    String            @default("{}")
  idealEntryReady      Boolean           @default(false)
  idealEntryReason     String            @default("Waiting for quality analysis")
  target1Probability   Float             @default(0)
  target2Probability   Float             @default(0)
  target3Probability   Float             @default(0)
  expectedHoldingMinutes Int             @default(0)
  expectedProfitPercent Float            @default(0)
  expectedDrawdownPercent Float          @default(0)
  qualityEvaluatedAt   DateTime?
  entryRsi             Float             @default(0)
  ema200Aligned        Boolean           @default(false)
  volumeIncreasing     Boolean           @default(false)
  marketTrendAligned   Boolean           @default(false)
  sectorStrength       Float             @default(0)
  atr                  Float?
  previousCandleLow    Float?
  previousCandleHigh   Float?
  top100Selected       Boolean           @default(false)
  setupFingerprint     String            @default("")
  status               String            @default("WAITING")
  entryTriggeredAt     DateTime?
  entryExecutedPrice   Float?
  runningAt            DateTime?
  target1At            DateTime?
  target1HitAt         DateTime?
  target1ExecutedPrice Float?
  target2At            DateTime?
  target2HitAt         DateTime?
  target2ExecutedPrice Float?
  target3At            DateTime?
  target3HitAt         DateTime?
  target3ExecutedPrice Float?
  stopLossAt           DateTime?
  stopLossHitAt        DateTime?
  completedAt          DateTime?
  exitPrice            Float?
  profitPercent        Float?
  lossPercent          Float?
  holdingMinutes       Int?
  updatedAt            DateTime          @updatedAt

  @@index([userId, signalTime])
  @@index([userId, status])
  @@index([instrumentKey, status])
  @@index([userId, top100Selected, signalTime])
}

model TradeManagementDecision {
  id                   String   @id @default(cuid())
  tradeId              String   @unique
  trade                AiSignal @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  status               String
  action               String
  reason               String
  confidence           Float
  reentryStatus        String?
  trailingStop         Float?
  partialProfitPercent Float    @default(0)
  evaluatedCandleTime  DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model PostTradeAnalysis {
  id                    String   @id @default(cuid())
  tradeId               String   @unique
  trade                 AiSignal @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  entryQuality          String
  exitQuality           String
  pnlPercent            Float
  exitReason            String
  targetProgression     String
  entryIndicators       String
  exitIndicators        String
  marketContext         String
  aiSummary             String
  keyReasons            String
  explanationConfidence Float
  mistakesDetected      String
  suggestedImprovement  String
  recoveryProbability   Float?
  breakdownProbability  Float?
  futureRecommendation  String
  specialScenarios      String
  newsSentiment         String?
  analyzedThrough       DateTime
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model StopLossDecision {
  id                     String                  @id @default(cuid())
  tradeId                String                  @unique
  trade                  AiSignal                @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  status                 String
  recoveryProbability    Float
  breakdownProbability   Float
  confidence             Float
  reason                 String
  recommendation         String
  touchedAt              DateTime
  confirmationCandleTime DateTime
  resolvedAt             DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  timeline               StopLossDecisionEvent[]
}

model StopLossDecisionEvent {
  id         String           @id @default(cuid())
  decisionId String
  decision   StopLossDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  type       String
  detail     String
  value      Float?
  eventTime  DateTime         @default(now())

  @@index([decisionId, eventTime])
}

model AiTradeEvent {
  id             String   @id @default(cuid())
  tradeId        String
  trade          AiSignal @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  type           String
  triggerPrice   Float
  executedPrice  Float
  eventTime      DateTime @default(now())
  profitPercent  Float
  holdingMinutes Int

  @@unique([tradeId, type])
  @@index([tradeId, eventTime])
}

model Token {
  id                   String    @id @default(cuid())
  encryptedAccessToken String
  expiresAt            DateTime?
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt            DateTime  @updatedAt
}

model WatchlistItem {
  id            String   @id @default(cuid())
  instrumentKey String
  symbol        String
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@unique([userId, instrumentKey])
}

model NseInstrument {
  instrumentKey String   @id
  symbol        String
  exchange      String
  isin          String?
  company       String
  sector        String   @default("NSE Equity")
  token         String
  intradayMargin Float?
  intradayLeverage Float?
  active        Boolean  @default(true)
  updatedAt     DateTime @updatedAt

  @@index([symbol])
  @@index([active])
}

model HistoricalCandle {
  id            String   @id @default(cuid())
  instrumentKey String
  timeframe     String
  candleTime    DateTime
  open          Float
  high          Float
  low           Float
  close         Float
  volume        Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([instrumentKey, timeframe, candleTime])
  @@index([instrumentKey, timeframe, candleTime])
}
