generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String               @id @default(cuid())
  upstoxUserId String               @unique
  name         String?
  email        String?
  token        Token?
  watchlist    WatchlistItem[]
  aiSignals    AiSignal[]
  paperAccounts PaperTradingAccount[]
  paperOrders  PaperOrder[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

model PaperTradingAccount {
  id                String   @id @default(cuid())
  userId            String
  portfolio         String   @default("STRATEGY")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled           Boolean  @default(true)
  autoDemoTrading   Boolean  @default(false)
  startingBalance   Float    @default(10000)
  minimumConfidence Float    @default(90)
  maxOpenTrades     Int      @default(4)
  riskPerTrade      Float    @default(2)
  allowAiWait       Boolean  @default(true)
  allowReentry      Boolean  @default(true)
  realizedPnl       Float    @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([userId, portfolio])
}

model PaperOrder {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  signalId        String?
  portfolio       String    @default("STRATEGY")
  instrumentKey   String
  symbol          String
  side            String
  confidence      Float
  status          String    @default("WAITING")
  quantity        Int
  budget          Float
  plannedEntry    Float
  entryPrice      Float?
  currentPrice    Float
  investment      Float
  target          Float
  stopLoss        Float
  entryTime       DateTime?
  exitTime        DateTime?
  exitPrice       Float?
  pnl             Float     @default(0)
  pnlPercent      Float     @default(0)
  grossPnl        Float?
  entryBrokerage  Float?
  exitBrokerage   Float?
  otherCharges    Float?
  totalCharges    Float?
  netPnl          Float?
  chargesSource   String?
  exitReason      String?
  niftyDemo       String?
  durationMinutes Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId, status])
  @@index([userId, portfolio, exitTime])
  @@index([userId, instrumentKey, createdAt])
  @@unique([signalId, portfolio])
}

model DemoTradeQueue {
  id            String   @id @default(cuid())
  userId        String
  signalId      String
  portfolio     String   @default("STRATEGY")
  instrumentKey String
  symbol        String
  side          String
  entryPrice    Float
  confidence    Float
  aiScore       Float
  riskReward    Float
  signalTime    DateTime
  status        String   @default("WAITING_FOR_CAPITAL")
  queuedAt      DateTime @default(now())
  executedAt    DateTime?
  rejectedAt    DateTime?
  rejectReason  String?
  updatedAt     DateTime @updatedAt

  @@index([userId, status, confidence, aiScore])
  @@unique([signalId, portfolio])
}

model EodRiskRun {
  id             String    @id @default(cuid())
  tradingDate    String
  userId         String
  scope          String
  status         String
  brokerOrderIds String?
  alert          String?
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  updatedAt      DateTime  @updatedAt

  @@unique([tradingDate, userId, scope])
  @@index([tradingDate, status])
}

model AiSignal {
  strategyResult      AiStrategyResult?
  id                   String            @id @default(cuid())
  signalKey            String            @unique
  userId               String
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  events               AiTradeEvent[]
  stopLossDecision     StopLossDecision?
  managementDecision   TradeManagementDecision?
  postTradeAnalysis    PostTradeAnalysis?
  instrumentKey        String
  stockName            String
  symbol               String
  sector               String            @default("NSE Equity")
  strategy             String
  timeframe            String
  side                 String
  signalTime           DateTime          @default(now())
  signalGeneratedAt    DateTime          @default(now())
  currentPrice         Float
  entryPrice           Float
  stopLoss             Float
  target1              Float
  target2              Float
  target3              Float
  confidence           Int
  aiScore              Int
  riskReward           Float
  volume               Float             @default(0)
  universeRank         Int               @default(0)
  selectionScore       Float             @default(0)
  top100Selected       Boolean           @default(false)
  aiStrategyListed     Boolean           @default(false)
  aiStrategyRank       Int?
  aiStrategyListedAt   DateTime?
  niftyContext         NiftySignalContext?
  setupFingerprint     String            @default("")
  status               String            @default("WAITING")
  entryTriggeredAt     DateTime?
  entryExecutedPrice   Float?
  runningAt            DateTime?
  target1At            DateTime?
  target1HitAt         DateTime?
  target1ExecutedPrice Float?
  target2At            DateTime?
  target2HitAt         DateTime?
  target2ExecutedPrice Float?
  target3At            DateTime?
  target3HitAt         DateTime?
  target3ExecutedPrice Float?
  stopLossAt           DateTime?
  stopLossHitAt        DateTime?
  completedAt          DateTime?
  exitPrice            Float?
  profitPercent        Float?
  lossPercent          Float?
  holdingMinutes       Int?
  updatedAt            DateTime          @updatedAt

  @@index([userId, signalTime])
  @@index([userId, status])
  @@index([instrumentKey, status])
  @@index([userId, top100Selected, signalTime])
  @@index([userId, aiStrategyListed, signalTime])
}

model TradeManagementDecision {
  id                   String   @id @default(cuid())
  tradeId              String   @unique
  trade                AiSignal @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  status               String
  action               String
  reason               String
  confidence           Float
  reentryStatus        String?
  trailingStop         Float?
  partialProfitPercent Float    @default(0)
  evaluatedCandleTime  DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model PostTradeAnalysis {
  id                    String   @id @default(cuid())
  tradeId               String   @unique
  trade                 AiSignal @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  entryQuality          String
  exitQuality           String
  pnlPercent            Float
  exitReason            String
  targetProgression     String
  entryIndicators       String
  exitIndicators        String
  marketContext         String
  aiSummary             String
  keyReasons            String
  explanationConfidence Float
  mistakesDetected      String
  suggestedImprovement  String
  recoveryProbability   Float?
  breakdownProbability  Float?
  futureRecommendation  String
  specialScenarios      String
  newsSentiment         String?
  analyzedThrough       DateTime
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model StopLossDecision {
  id                     String                  @id @default(cuid())
  tradeId                String                  @unique
  trade                  AiSignal                @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  status                 String
  recoveryProbability    Float
  breakdownProbability   Float
  confidence             Float
  reason                 String
  recommendation         String
  touchedAt              DateTime
  confirmationCandleTime DateTime
  resolvedAt             DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  timeline               StopLossDecisionEvent[]
}

model StopLossDecisionEvent {
  id         String           @id @default(cuid())
  decisionId String
  decision   StopLossDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  type       String
  detail     String
  value      Float?
  eventTime  DateTime         @default(now())

  @@index([decisionId, eventTime])
}

// Durable report membership, independent of the changing scanner ranking.
model AiStrategyResult {
  tradeId    String   @id
  trade      AiSignal @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  observedAt DateTime @default(now())
  source     String
}

model AiTradeEvent {
  id             String   @id @default(cuid())
  tradeId        String
  trade          AiSignal @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  type           String
  triggerPrice   Float
  executedPrice  Float
  eventTime      DateTime @default(now())
  profitPercent  Float
  holdingMinutes Int

  @@unique([tradeId, type])
  @@index([tradeId, eventTime])
}

model Token {
  id                   String    @id @default(cuid())
  encryptedAccessToken String
  expiresAt            DateTime?
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt            DateTime  @updatedAt
}

model WatchlistItem {
  id            String   @id @default(cuid())
  instrumentKey String
  symbol        String
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@unique([userId, instrumentKey])
}

model NseInstrument {
  instrumentKey String   @id
  symbol        String
  exchange      String
  isin          String?
  company       String
  sector        String   @default("NSE Equity")
  token         String
  active        Boolean  @default(true)
  updatedAt     DateTime @updatedAt

  @@index([symbol])
  @@index([active])
}

model HistoricalCandle {
  id            String   @id @default(cuid())
  instrumentKey String
  timeframe     String
  candleTime    DateTime
  open          Float
  high          Float
  low           Float
  close         Float
  volume        Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([instrumentKey, timeframe, candleTime])
  @@index([instrumentKey, timeframe, candleTime])
}

// Canonical prices, lifecycle and event ledger remain in AiSignal/AiTradeEvent.
model NiftySignalContext {
  signalId String @id
  signal AiSignal @relation(fields: [signalId], references: [id], onDelete: Cascade)
  setupId String @unique
  inputs String
  optionContract String
  reasons String
  invalidations String
  setupDetectedAt DateTime
}
model NiftyRiskConfiguration {
  userId String @id
  settings String
  updatedAt DateTime @updatedAt
}
model NiftyBacktestResult {
  id String @id @default(cuid())
  userId String
  fromDate String
  toDate String
  settings String
  results String
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}

model NiftyOpportunity {
  id String @id @default(cuid())
  userId String
  setupId String
  strategy String
  side String
  detectedAt DateTime @default(now())
  score Int
  @@unique([userId, setupId])
  @@index([userId, detectedAt])
}

// One shared live slot; switches only govern new entries, never exits.
model RealTradingControl {
  userId String @id
  strategyEnabledAt DateTime?
  historyEnabledAt DateTime?
  activeTradeId String?
  lastReleasedAt DateTime?
  revision Int @default(0)
  leaseOwner String?
  leaseUntil DateTime?
  updatedAt DateTime @updatedAt
}

model RealTrade {
  id String @id @default(cuid())
  userId String
  signalId String
  source String
  instrumentKey String
  symbol String
  side String
  target Float
  stopLoss Float
  hitAt DateTime
  status String
  quantity Int @default(0)
  entryPrice Float?
  exitPrice Float?
  entryTime DateTime?
  exitTime DateTime?
  exitReason String?
  error String?
  attempts RealOrderAttempt[]
  events RealExecutionEvent[]
  decisions RealSignalDecision[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId, signalId])
  @@index([userId, status])
}

// Persist before calling the broker. Unknown outcomes are reconciled by tag,
// never blindly resubmitted (including across process restarts).
model RealOrderAttempt {
  id String @id @default(cuid())
  tradeId String
  trade RealTrade @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  kind String
  tag String @unique
  brokerOrderId String? @unique
  quantity Int
  filledQuantity Int @default(0)
  averagePrice Float @default(0)
  status String @default("SUBMITTING")
  error String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([tradeId, kind])
}


model RealExecutionEvent {
  id String @id @default(cuid())
  tradeId String
  trade RealTrade @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  key String
  type String
  observedAt DateTime
  origin String
  detail String
  brokerTimestamp String?
  @@unique([tradeId, key])
  @@index([tradeId, observedAt])
}

model RealSignalDecision {
  id String @id @default(cuid())
  userId String
  signalId String
  source String
  symbol String
  side String
  hitAt DateTime
  observedAt DateTime
  eligibleAtHit Boolean
  enabledAt DateTime?
  code String
  reason String
  tradeId String?
  trade RealTrade? @relation(fields: [tradeId], references: [id], onDelete: SetNull)
  @@unique([userId, signalId, source])
  @@index([userId, hitAt])
}
