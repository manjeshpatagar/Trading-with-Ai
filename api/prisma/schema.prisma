generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String               @id @default(cuid())
  upstoxUserId String               @unique
  name         String?
  email        String?
  token        Token?
  watchlist    WatchlistItem[]
  aiSignals    AiSignal[]
  paperAccount PaperTradingAccount?
  paperOrders  PaperOrder[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

model PaperTradingAccount {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled           Boolean  @default(true)
  autoDemoTrading   Boolean  @default(false)
  startingBalance   Float    @default(10000)
  minimumConfidence Float    @default(90)
  maxOpenTrades     Int      @default(4)
  riskPerTrade      Float    @default(2)
  allowAiWait       Boolean  @default(true)
  allowReentry      Boolean  @default(true)
  realizedPnl       Float    @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model PaperOrder {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  signalId        String?   @unique
  instrumentKey   String
  symbol          String
  side            String
  confidence      Float
  status          String    @default("WAITING")
  quantity        Int
  budget          Float
  plannedEntry    Float
  entryPrice      Float?
  currentPrice    Float
  investment      Float
  target          Float
  stopLoss        Float
  entryTime       DateTime?
  exitTime        DateTime?
  exitPrice       Float?
  pnl             Float     @default(0)
  pnlPercent      Float     @default(0)
  exitReason      String?
  durationMinutes Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId, status])
  @@index([userId, instrumentKey, createdAt])
}

model DemoTradeQueue {
  id            String   @id @default(cuid())
  userId        String
  signalId      String   @unique
  instrumentKey String
  symbol        String
  side          String
  entryPrice    Float
  confidence    Float
  aiScore       Float
  riskReward    Float
  signalTime    DateTime
  status        String   @default("WAITING_FOR_CAPITAL")
  queuedAt      DateTime @default(now())
  executedAt    DateTime?
  rejectedAt    DateTime?
  rejectReason  String?
  updatedAt     DateTime @updatedAt

  @@index([userId, status, confidence, aiScore])
}

model RealTradingAccount {
  id                 String   @id @default(cuid())
  userId             String   @unique
  tradingCapital     Float    @default(10000)
  maxOpenTrades      Int      @default(1)
  riskPerTrade       Float    @default(1)
  minimumConfidence  Float    @default(95)
  maxDailyLoss       Float    @default(1000)
  maxDailyProfit     Float    @default(2000)
  autoTrading        Boolean  @default(false)
  buySignals         Boolean  @default(true)
  sellSignals        Boolean  @default(true)
  squareOffTime      String   @default("15:15")
  connectionTime     DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model RealTradeOrder {
  id              String    @id @default(cuid())
  userId          String
  signalId        String    @unique
  brokerOrderId   String?   @unique
  instrumentKey   String
  symbol          String
  side            String
  aiConfidence    Float
  aiAnalysis      String
  status          String
  entryPrice      Float
  currentPrice    Float
  quantity        Int
  allocatedCapital Float
  investment      Float
  target1         Float
  target2         Float
  target3         Float
  stopLoss        Float
  currentStop     Float
  targetProgress  String    @default("ENTRY")
  pnl             Float     @default(0)
  pnlPercent      Float     @default(0)
  executionTime   DateTime?
  exitPrice       Float?
  exitReason      String?
  exitTime        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId, status])
}

model RealTradeQueue {
  id            String   @id @default(cuid())
  userId        String
  signalId      String   @unique
  instrumentKey String
  symbol        String
  side          String
  entryPrice    Float
  confidence    Float
  aiScore       Float
  riskReward    Float
  signalTime    DateTime
  status        String   @default("WAITING_FOR_SLOT")
  queuedAt      DateTime @default(now())
  resolvedAt    DateTime?
  reason        String?
  updatedAt     DateTime @updatedAt

  @@index([userId, status, confidence, aiScore])
}

model EodRiskRun {
  id             String    @id @default(cuid())
  tradingDate    String
  userId         String
  scope          String
  status         String
  brokerOrderIds String?
  alert          String?
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  updatedAt      DateTime  @updatedAt

  @@unique([tradingDate, userId, scope])
  @@index([tradingDate, status])
}

model AiSignal {
  id                   String            @id @default(cuid())
  signalKey            String            @unique
  userId               String
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  events               AiTradeEvent[]
  stopLossDecision     StopLossDecision?
  managementDecision   TradeManagementDecision?
  postTradeAnalysis    PostTradeAnalysis?
  instrumentKey        String
  stockName            String
  symbol               String
  sector               String            @default("NSE Equity")
  strategy             String
  timeframe            String
  side                 String
  signalTime           DateTime          @default(now())
  signalGeneratedAt    DateTime          @default(now())
  currentPrice         Float
  entryPrice           Float
  stopLoss             Float
  target1              Float
  target2              Float
  target3              Float
  confidence           Int
  aiScore              Int
  riskReward           Float
  volume               Float             @default(0)
  universeRank         Int               @default(0)
  selectionScore       Float             @default(0)
  top100Selected       Boolean           @default(false)
  setupFingerprint     String            @default("")
  status               String            @default("WAITING")
  entryTriggeredAt     DateTime?
  entryExecutedPrice   Float?
  runningAt            DateTime?
  target1At            DateTime?
  target1HitAt         DateTime?
  target1ExecutedPrice Float?
  target2At            DateTime?
  target2HitAt         DateTime?
  target2ExecutedPrice Float?
  target3At            DateTime?
  target3HitAt         DateTime?
  target3ExecutedPrice Float?
  stopLossAt           DateTime?
  stopLossHitAt        DateTime?
  completedAt          DateTime?
  exitPrice            Float?
  profitPercent        Float?
  lossPercent          Float?
  holdingMinutes       Int?
  updatedAt            DateTime          @updatedAt

  @@index([userId, signalTime])
  @@index([userId, status])
  @@index([instrumentKey, status])
  @@index([userId, top100Selected, signalTime])
}

model TradeManagementDecision {
  id                   String   @id @default(cuid())
  tradeId              String   @unique
  trade                AiSignal @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  status               String
  action               String
  reason               String
  confidence           Float
  reentryStatus        String?
  trailingStop         Float?
  partialProfitPercent Float    @default(0)
  evaluatedCandleTime  DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model PostTradeAnalysis {
  id                    String   @id @default(cuid())
  tradeId               String   @unique
  trade                 AiSignal @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  entryQuality          String
  exitQuality           String
  pnlPercent            Float
  exitReason            String
  targetProgression     String
  entryIndicators       String
  exitIndicators        String
  marketContext         String
  aiSummary             String
  keyReasons            String
  explanationConfidence Float
  mistakesDetected      String
  suggestedImprovement  String
  recoveryProbability   Float?
  breakdownProbability  Float?
  futureRecommendation  String
  specialScenarios      String
  newsSentiment         String?
  analyzedThrough       DateTime
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model StopLossDecision {
  id                     String                  @id @default(cuid())
  tradeId                String                  @unique
  trade                  AiSignal                @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  status                 String
  recoveryProbability    Float
  breakdownProbability   Float
  confidence             Float
  reason                 String
  recommendation         String
  touchedAt              DateTime
  confirmationCandleTime DateTime
  resolvedAt             DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  timeline               StopLossDecisionEvent[]
}

model StopLossDecisionEvent {
  id         String           @id @default(cuid())
  decisionId String
  decision   StopLossDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  type       String
  detail     String
  value      Float?
  eventTime  DateTime         @default(now())

  @@index([decisionId, eventTime])
}

model AiTradeEvent {
  id             String   @id @default(cuid())
  tradeId        String
  trade          AiSignal @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  type           String
  triggerPrice   Float
  executedPrice  Float
  eventTime      DateTime @default(now())
  profitPercent  Float
  holdingMinutes Int

  @@unique([tradeId, type])
  @@index([tradeId, eventTime])
}

model Token {
  id                   String    @id @default(cuid())
  encryptedAccessToken String
  expiresAt            DateTime?
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt            DateTime  @updatedAt
}

model WatchlistItem {
  id            String   @id @default(cuid())
  instrumentKey String
  symbol        String
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@unique([userId, instrumentKey])
}

model NseInstrument {
  instrumentKey String   @id
  symbol        String
  exchange      String
  isin          String?
  company       String
  sector        String   @default("NSE Equity")
  token         String
  active        Boolean  @default(true)
  updatedAt     DateTime @updatedAt

  @@index([symbol])
  @@index([active])
}

model HistoricalCandle {
  id            String   @id @default(cuid())
  instrumentKey String
  timeframe     String
  candleTime    DateTime
  open          Float
  high          Float
  low           Float
  close         Float
  volume        Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([instrumentKey, timeframe, candleTime])
  @@index([instrumentKey, timeframe, candleTime])
}
